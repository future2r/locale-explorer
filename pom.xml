<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>name.ulbricht</groupId>
    <artifactId>locale-explorer</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>Locale Explorer</name>
    <description>Explores how Java localizes dates, times, numbers, currencies, lists and text.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            Fixed timestamp in the JAR: the same sources give the same JAR, as long as Maven runs on
            the same JDK version (the manifest names it).
        -->
        <project.build.outputTimestamp>2026-11-24T00:00:00Z</project.build.outputTimestamp>

        <java.version>27</java.version>
        <javafx.version>27.0.1</javafx.version>
        <junit.version>6.1.3</junit.version>

        <!-- jpackage accepts only numeric versions, so this is kept apart from the project version. -->
        <app.version>0.1.0</app.version>
        <app.name>Locale Explorer</app.name>

        <main.module>name.ulbricht.locale.explorer</main.module>
        <main.class>name.ulbricht.locale.explorer.LocaleExplorerApp</main.class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Runtime: JavaFX only, no other third-party libraries. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Maven itself must run on JDK 27: the JAR and JavaFX plugins read the Java 27 module
                descriptor in Maven's own JVM. Without this check they fail with cryptic messages.
            -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-java-and-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[27,)</version>
                                    <message>Run Maven on JDK 27 or newer (set JAVA_HOME).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Uses the JDK 27 entry from ~/.m2/toolchains.xml for compiling, jlink and jpackage. -->
            <plugin>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>${java.version}</version>
                            <vendor>openjdk</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.module}/${main.class}</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Per operating system and processor: the classifier of the JavaFX jars (copied for
            jlink) and the application icon for jpackage. The processor names are those Java
            reports in os.arch. Other platforms get no profile; the package profile then stops
            with a message instead of linking the wrong native libraries.
        -->
        <profile>
            <id>windows-x64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
                <app.icon>${project.basedir}/src/packaging/windows/locale-explorer.ico</app.icon>
            </properties>
        </profile>
        <profile>
            <id>linux-x64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
                <app.icon>${project.basedir}/src/packaging/linux/locale-explorer.png</app.icon>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux-aarch64</javafx.platform>
                <app.icon>${project.basedir}/src/packaging/linux/locale-explorer.png</app.icon>
            </properties>
        </profile>
        <profile>
            <id>mac-x64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
                <app.icon>${project.basedir}/src/packaging/macos/locale-explorer.icns</app.icon>
                <!-- jpackage on macOS rejects versions starting with 0; there it is 1.0.0 until then. -->
                <app.version>1.0.0</app.version>
            </properties>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac-aarch64</javafx.platform>
                <app.icon>${project.basedir}/src/packaging/macos/locale-explorer.icns</app.icon>
                <!-- jpackage on macOS rejects versions starting with 0; there it is 1.0.0 until then. -->
                <app.version>1.0.0</app.version>
            </properties>
        </profile>
        <!--
            ./mvnw -Ppackage clean package
            Creates a runtime image with jlink (target/locale-explorer) and from it a
            self-contained application folder with jpackage (target/dist/Locale Explorer).
            jlink and jpackage are taken from the JDK 27 toolchain.
        -->
        <profile>
            <id>package</id>
            <build>
                <plugins>
                    <!-- Only platforms with an OS profile above can be packaged. -->
                    <plugin>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-platform</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>javafx.platform</property>
                                            <message>No JavaFX platform profile matches ${os.name} ${os.arch}; packaging is not supported here.</message>
                                        </requireProperty>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        jlink and jpackage refuse to write into existing folders, also without clean;
                        old JavaFX jars in the modules folder would clash with new versions.
                    -->
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>remove-images</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/locale-explorer</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${project.build.directory}/dist</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${project.build.directory}/modules</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        javafx:jlink is not used: with a toolchain, javafx-maven-plugin 0.0.8 calls
                        java instead of jlink. The JavaFX modules of this platform are copied and
                        linked directly instead.
                    -->
                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.11.0</version>
                        <executions>
                            <execution>
                                <id>copy-modules</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <classifier>${javafx.platform}</classifier>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <!-- a plain name: exec-maven-plugin looks it up in the JDK toolchain -->
                                    <executable>jlink</executable>
                                    <arguments>
                                        <argument>--module-path</argument>
                                        <argument>${project.build.directory}/modules${path.separator}${project.build.outputDirectory}</argument>
                                        <argument>--add-modules</argument>
                                        <!--
                                            jdk.localedata holds the CLDR data of all locales except
                                            English; it is a service provider and not linked on its own.
                                            jdk.charsets adds less common charsets such as Big5, EUC-JP or EBCDIC.
                                        -->
                                        <argument>${main.module},jdk.localedata,jdk.charsets</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/locale-explorer</argument>
                                        <argument>--launcher</argument>
                                        <argument>locale-explorer=${main.module}/${main.class}</argument>
                                        <!-- for the jlink launcher and, via the runtime, for the jpackage launcher -->
                                        <argument>--add-options=--enable-native-access=javafx.graphics</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--no-man-pages</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${app.version}</argument>
                                        <argument>--description</argument>
                                        <argument>${project.description}</argument>
                                        <argument>--icon</argument>
                                        <argument>${app.icon}</argument>
                                        <argument>--runtime-image</argument>
                                        <argument>${project.build.directory}/locale-explorer</argument>
                                        <argument>--module</argument>
                                        <argument>${main.module}/${main.class}</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
